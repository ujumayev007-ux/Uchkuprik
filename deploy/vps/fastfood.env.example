# Environment variable NAMES of the central server. Copy to /etc/fastfood/fastfood.env
# and fill in the values on the server itself. Never commit the filled-in file.
# Values written as <...> are placeholders.

NODE_ENV=production
HOST=127.0.0.1
PORT=8787
# Public HTTPS address of this server (also used for payment callbacks and CORS).
APP_ORIGIN=https://<control.example.uz>
# One proxy hop (Caddy) in front of the server.
TRUST_PROXY=1
LOG_LEVEL=info

# PostgreSQL. Local database on the same VPS: ?sslmode=disable is acceptable on
# 127.0.0.1; a remote database needs ?sslmode=verify-full.
DATABASE_URL=postgresql://<user>:<password>@127.0.0.1:5432/<database>?sslmode=disable

# MUST be the SAME value as on the old server (32 random bytes, base64). It seals MFA
# secrets and keys the licence-key hashes: a different value invalidates both.
APP_SECRET_KEY=<same as old server>

# Central control plane. The signing key MUST be the SAME as on the old server:
# installed restaurants only trust grants signed by it.
CONTROL_PLANE=true
CONTROL_SIGNING_KEY=<same as old server (base64 of the PEM)>

# Optional.
# METRICS_TOKEN=<random 32+ characters>
# CREDENTIAL_RATE_LIMIT=
# SIGNUP_RATE_LIMIT=

# Set ONLY on the OLD server while installs move to the new address (see
# docs/server-migration.md). Installs learn the new address from their next signed
# heartbeat answer.
# CONTROL_RELOCATE_URL=https://<control.example.uz>
