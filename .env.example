# Run npm run setup:env to create a local .env with a random database password.
# Never reuse local credentials in production or commit .env files.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
APP_ORIGIN=http://localhost:5173
LOG_LEVEL=info
DATABASE_URL=postgresql://fastfood:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:5433/fastfood?schema=public
POSTGRES_USER=fastfood
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
POSTGRES_DB=fastfood
POSTGRES_PORT=5433
