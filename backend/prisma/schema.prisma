generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// Conventions: UUIDv7 keys, table names mapped to snake_case, every business row
// carries tenantId. Tenant scoping is enforced in the service layer from the
// authenticated session, never from client-provided identifiers.

enum TenantKind {
  PLATFORM
  BUSINESS
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AuthMethod {
  PASSWORD
  PIN
}

enum DeviceStatus {
  ACTIVE
  REVOKED
}

model Tenant {
  id                  String       @id @default(uuid(7)) @db.Uuid
  slug                String       @unique
  name                String
  kind                TenantKind   @default(BUSINESS)
  status              TenantStatus @default(ACTIVE)
  // Security policy: when true every user with a privileged role must use MFA.
  requireMfaForAdmins Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  branches       Branch[]
  users          User[]
  roles          Role[]
  sessions       Session[]
  devices        Device[]
  profile        TenantProfile?
  menuCategories MenuCategory[]
  modifierGroups ModifierGroup[]

  @@map("tenants")
}

model Branch {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @db.Uuid
  code      String
  name      String
  address   String?
  phone     String?
  timezone  String    @default("Asia/Tashkent")
  currency  String    @default("UZS")
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  users    UserBranch[]
  devices  Device[]
  sessions Session[]
  rooms    Room[]
  tables   DiningTable[]
  prices   BranchVariantPrice[]
  shifts   CashShift[]
  orders   Order[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, isActive])
  @@map("branches")
}

model User {
  id                 String     @id @default(uuid(7)) @db.Uuid
  tenantId           String     @db.Uuid
  username           String
  displayName        String
  phone              String?
  status             UserStatus @default(ACTIVE)
  isPlatformAdmin    Boolean    @default(false)
  // True grants access to every branch of the tenant; otherwise see UserBranch.
  allBranches        Boolean    @default(false)
  passwordHash       String?
  passwordChangedAt  DateTime?
  mustChangePassword Boolean    @default(false)
  pinHash            String?
  pinChangedAt       DateTime?
  mfaSecretEnc       String?
  mfaEnabledAt       DateTime?
  mfaLastStep        BigInt?
  failedLoginCount   Int        @default(0)
  lockedUntil        DateTime?
  failedPinCount     Int        @default(0)
  pinLockedUntil     DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  roles    UserRole[]
  branches UserBranch[]
  sessions Session[]

  @@unique([tenantId, username])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @db.Uuid
  // Stable key for system roles (owner, admin, cashier...). Null for custom roles.
  systemKey   String?
  name        String
  description String?
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  users  UserRole[]

  @@unique([tenantId, name])
  @@unique([tenantId, systemKey])
  @@unique([tenantId, id])
  @@map("roles")
}

model UserRole {
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())

  // Composite foreign keys make cross-tenant assignments impossible in the database.
  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  role Role @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([tenantId, roleId])
  @@map("user_roles")
}

model UserBranch {
  tenantId String @db.Uuid
  userId   String @db.Uuid
  branchId String @db.Uuid

  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)

  @@id([userId, branchId])
  @@index([tenantId, branchId])
  @@map("user_branches")
}

model Device {
  id             String       @id @default(uuid(7)) @db.Uuid
  tenantId       String       @db.Uuid
  branchId       String       @db.Uuid
  name           String
  tokenHash      String       @unique
  status         DeviceStatus @default(ACTIVE)
  registeredById String       @db.Uuid
  lastSeenAt     DateTime?
  createdAt      DateTime     @default(now())
  revokedAt      DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch   Branch    @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  sessions Session[]

  @@index([tenantId, branchId])
  @@map("devices")
}

model Session {
  id            String     @id @default(uuid(7)) @db.Uuid
  tokenHash     String     @unique
  tenantId      String     @db.Uuid
  userId        String     @db.Uuid
  branchId      String?    @db.Uuid
  deviceId      String?    @db.Uuid
  authMethod    AuthMethod
  // False until the second factor is verified for MFA-enabled users.
  mfaVerified   Boolean    @default(false)
  reauthAt      DateTime?
  createdAt     DateTime   @default(now())
  lastSeenAt    DateTime   @default(now())
  idleExpiresAt DateTime
  expiresAt     DateTime
  revokedAt     DateTime?
  revokeReason  String?
  ipAddress     String?
  userAgent     String?

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User    @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([tenantId, createdAt])
  @@map("sessions")
}

// Append-only. A database trigger rejects UPDATE and DELETE (see migration).
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  tenantId    String?  @db.Uuid
  branchId    String?  @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String?
  entityId    String?
  outcome     String   @default("SUCCESS")
  data        Json?
  ipAddress   String?
  requestId   String?
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, action, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Phase 3: restaurant configuration. Money is stored as integer amounts in the
// currency's smallest unit in use (so‘m for UZS); never floating point.

model TenantProfile {
  tenantId        String   @id @db.Uuid
  legalName       String?
  taxId           String?
  phone           String?
  address         String?
  receiptHeader   String?
  receiptFooter   String?
  // Percentage in basis points (1000 = 10%).
  serviceChargeBp Int      @default(0)
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("tenant_profiles")
}

model Room {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  branchId  String   @db.Uuid
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tables DiningTable[]
  branch Branch        @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([branchId, name])
  @@index([tenantId, branchId])
  @@map("rooms")
}

model DiningTable {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  branchId  String   @db.Uuid
  roomId    String   @db.Uuid
  name      String
  seats     Int      @default(4)
  // Opaque token for table QR menus (Phase 7); rotate to invalidate printed codes.
  qrToken   String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room   Room   @relation(fields: [tenantId, roomId], references: [tenantId, id], onDelete: Restrict)
  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)

  orders Order[]

  @@unique([tenantId, id])
  @@unique([branchId, name])
  @@index([tenantId, branchId])
  @@map("dining_tables")
}

model MenuCategory {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  parentId  String?  @db.Uuid
  // Kitchen station that prepares this category's items (null = every station).
  stationId String?  @db.Uuid
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parent   MenuCategory?   @relation("CategoryTree", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict)
  station  KitchenStation? @relation(fields: [tenantId, stationId], references: [tenantId, id], onDelete: Restrict)
  children MenuCategory[]  @relation("CategoryTree")
  products Product[]

  @@unique([tenantId, id])
  @@index([tenantId, parentId])
  @@map("menu_categories")
}

model Product {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @db.Uuid
  categoryId      String    @db.Uuid
  name            String
  description     String?
  sku             String?
  barcode         String?
  imageUrl        String?
  allergens       String[]
  prepTimeMinutes Int?
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  version         Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  category       MenuCategory           @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  variants       ProductVariant[]
  modifierGroups ProductModifierGroup[]

  @@unique([tenantId, id])
  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, categoryId])
  @@map("products")
}

// Every product has at least one variant; simple products have a single default size.
model ProductVariant {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  productId String   @db.Uuid
  name      String
  price     Int
  // Internal cost: only returned to holders of menu.cost.view.
  cost      Int?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product      Product              @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)
  branchPrices BranchVariantPrice[]
  orderItems   OrderItem[]

  @@unique([tenantId, id])
  @@index([productId])
  @@map("product_variants")
}

model BranchVariantPrice {
  tenantId    String   @db.Uuid
  branchId    String   @db.Uuid
  variantId   String   @db.Uuid
  // Null keeps the base price and only overrides availability.
  price       Int?
  isAvailable Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  variant ProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Cascade)
  branch  Branch         @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)

  @@id([branchId, variantId])
  @@index([tenantId, variantId])
  @@map("branch_variant_prices")
}

model ModifierGroup {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  minSelect Int      @default(0)
  maxSelect Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  options  ModifierOption[]
  products ProductModifierGroup[]

  @@unique([tenantId, id])
  @@map("modifier_groups")
}

model ModifierOption {
  id        String  @id @default(uuid(7)) @db.Uuid
  tenantId  String  @db.Uuid
  groupId   String  @db.Uuid
  name      String
  price     Int     @default(0)
  cost      Int?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  group ModifierGroup @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([groupId])
  @@map("modifier_options")
}

model ProductModifierGroup {
  tenantId  String @db.Uuid
  productId String @db.Uuid
  groupId   String @db.Uuid
  sortOrder Int    @default(0)

  product Product       @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)
  group   ModifierGroup @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: Restrict)

  @@id([productId, groupId])
  @@map("product_modifier_groups")
}

// ---------------------------------------------------------------------------
// Phase 4: orders, payments and cashier shifts. Financial rows are never
// deleted; corrections are new rows (refunds, cancellations, cash movements).

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderChannel {
  POS
  WAITER
  QR
  WEB
  TELEGRAM
}

// DRAFT -> PLACED -> PREPARING -> READY -> SERVED -> COMPLETED; CANCELLED from
// DRAFT/PLACED. Transitions are enforced in modules/orders/state.ts.
enum OrderStatus {
  DRAFT
  PLACED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum OrderItemStatus {
  ACTIVE
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  CLICK
  PAYME
  UZUM
  OTHER
}

enum ShiftStatus {
  OPEN
  CLOSED
}

model CashShift {
  id           String      @id @default(uuid(7)) @db.Uuid
  tenantId     String      @db.Uuid
  branchId     String      @db.Uuid
  // Register identity: the device id, or "user:<id>" for browser sessions.
  registerKey  String
  deviceId     String?     @db.Uuid
  status       ShiftStatus @default(OPEN)
  openedById   String      @db.Uuid
  openedAt     DateTime    @default(now())
  openingCash  Int
  closedById   String?     @db.Uuid
  closedAt     DateTime?
  expectedCash Int?
  countedCash  Int?
  variance     Int?
  closeNote    String?

  branch        Branch         @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  cashMovements CashMovement[]
  payments      Payment[]
  refunds       Refund[]

  @@unique([tenantId, id])
  @@index([tenantId, branchId, openedAt])
  @@map("cash_shifts")
}

model CashMovement {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @db.Uuid
  shiftId     String   @db.Uuid
  // Positive = cash in (pay-in), negative = cash out (pay-out).
  amount      Int
  reason      String
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())

  shift CashShift @relation(fields: [tenantId, shiftId], references: [tenantId, id], onDelete: Restrict)

  @@index([shiftId])
  @@map("cash_movements")
}

model OrderCounter {
  branchId     String   @db.Uuid
  businessDate DateTime @db.Date
  lastNumber   Int      @default(0)

  @@id([branchId, businessDate])
  @@map("order_counters")
}

model Order {
  id              String       @id @default(uuid(7)) @db.Uuid
  tenantId        String       @db.Uuid
  branchId        String       @db.Uuid
  // Short daily number shown on receipts and queue screens.
  number          Int
  businessDate    DateTime     @db.Date
  type            OrderType
  channel         OrderChannel @default(POS)
  status          OrderStatus  @default(DRAFT)
  // 0 = normal, 1 = rush. Kitchen screens sort by priority, then age.
  priority        Int          @default(0)
  readyAt         DateTime?
  tableId         String?      @db.Uuid
  customerName    String?
  customerPhone   String?
  deliveryAddress String?
  note            String?
  subtotal        Int          @default(0)
  // Discount rule: percentage (basis points) and/or fixed amount, recomputed on change.
  discountBp      Int          @default(0)
  discountFixed   Int          @default(0)
  discountTotal   Int          @default(0)
  discountReason  String?
  serviceChargeBp Int          @default(0)
  serviceCharge   Int          @default(0)
  total           Int          @default(0)
  paidTotal       Int          @default(0)
  refundedTotal   Int          @default(0)
  idempotencyKey  String
  createdById     String?      @db.Uuid
  version         Int          @default(1)
  placedAt        DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  branch   Branch       @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  table    DiningTable? @relation(fields: [tableId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  events   OrderEvent[]
  payments Payment[]
  refunds  Refund[]

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@unique([branchId, businessDate, number])
  @@index([tenantId, branchId, status])
  @@index([tenantId, branchId, createdAt])
  @@map("orders")
}

model OrderItem {
  id               String          @id @default(uuid(7)) @db.Uuid
  tenantId         String          @db.Uuid
  orderId          String          @db.Uuid
  variantId        String          @db.Uuid
  // Snapshots: later menu changes never alter historical orders.
  productName      String
  variantName      String
  unitPrice        Int
  unitCost         Int?
  modifiers        Json            @default("[]")
  modifiersTotal   Int             @default(0)
  quantity         Int
  lineTotal        Int
  note             String?
  status           OrderItemStatus @default(ACTIVE)
  // Kitchen routing snapshot and preparation progress.
  stationId        String?         @db.Uuid
  prepTimeMinutes  Int?
  kitchenStatus    KitchenStatus   @default(QUEUED)
  prepStartedAt    DateTime?
  readyAt          DateTime?
  // Set when a kitchen ticket was queued for this item, so items print exactly once.
  kitchenPrintedAt DateTime?
  cancelReason     String?
  createdById      String?         @db.Uuid
  createdAt        DateTime        @default(now())

  order   Order          @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Restrict)

  @@index([orderId])
  @@index([tenantId, variantId])
  @@map("order_items")
}

// Append-only order history (status changes, edits, payments).
model OrderEvent {
  id        BigInt   @id @default(autoincrement())
  tenantId  String   @db.Uuid
  orderId   String   @db.Uuid
  type      String
  data      Json?
  actorId   String?  @db.Uuid
  createdAt DateTime @default(now())

  order Order @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)

  @@index([orderId, id])
  @@map("order_events")
}

model Payment {
  id             String        @id @default(uuid(7)) @db.Uuid
  tenantId       String        @db.Uuid
  branchId       String        @db.Uuid
  orderId        String        @db.Uuid
  shiftId        String?       @db.Uuid
  method         PaymentMethod
  amount         Int
  // Cash only: amount handed over and change returned.
  tendered       Int?
  change         Int?
  // External terminal or provider reference (card slip number, provider transaction id).
  reference      String?
  idempotencyKey String
  createdById    String?       @db.Uuid
  createdAt      DateTime      @default(now())

  order   Order      @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  shift   CashShift? @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([orderId])
  @@index([shiftId])
  @@map("payments")
}

model Refund {
  id           String        @id @default(uuid(7)) @db.Uuid
  tenantId     String        @db.Uuid
  orderId      String        @db.Uuid
  paymentId    String        @db.Uuid
  shiftId      String?       @db.Uuid
  method       PaymentMethod
  amount       Int
  reason       String
  approvedById String        @db.Uuid
  createdAt    DateTime      @default(now())

  order   Order      @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  payment Payment    @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Restrict)
  shift   CashShift? @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([shiftId])
  @@map("refunds")
}

// ---------------------------------------------------------------------------
// Phase 5: kitchen routing, kitchen statuses and printing.

enum KitchenStatus {
  QUEUED
  PREPARING
  READY
  SERVED
}

enum PrinterKind {
  RECEIPT
  KITCHEN
}

enum PrintJobStatus {
  PENDING
  SENT
  FAILED
}

model KitchenStation {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  categories MenuCategory[]
  printers   Printer[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@map("kitchen_stations")
}

// Network (raw TCP, ESC/POS) printers reachable from the API host or a local agent.
model Printer {
  id        String      @id @default(uuid(7)) @db.Uuid
  tenantId  String      @db.Uuid
  branchId  String      @db.Uuid
  name      String
  kind      PrinterKind
  stationId String?     @db.Uuid
  host      String
  port      Int         @default(9100)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())

  station KitchenStation? @relation(fields: [tenantId, stationId], references: [tenantId, id], onDelete: Restrict)
  jobs    PrintJob[]

  @@unique([tenantId, id])
  @@index([tenantId, branchId])
  @@map("printers")
}

model PrintJob {
  id        String         @id @default(uuid(7)) @db.Uuid
  tenantId  String         @db.Uuid
  printerId String         @db.Uuid
  orderId   String?        @db.Uuid
  kind      PrinterKind
  payload   Bytes
  status    PrintJobStatus @default(PENDING)
  attempts  Int            @default(0)
  lastError String?
  nextTryAt DateTime       @default(now())
  createdAt DateTime       @default(now())
  sentAt    DateTime?

  printer Printer @relation(fields: [tenantId, printerId], references: [tenantId, id], onDelete: Cascade)

  @@index([status, nextTryAt])
  @@map("print_jobs")
}
