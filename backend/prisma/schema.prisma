generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// Conventions: UUIDv7 keys, table names mapped to snake_case, every business row
// carries tenantId. Tenant scoping is enforced in the service layer from the
// authenticated session, never from client-provided identifiers.

enum TenantKind {
  PLATFORM
  BUSINESS
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AuthMethod {
  PASSWORD
  PIN
}

enum DeviceStatus {
  ACTIVE
  REVOKED
  // Registered by the restaurant Admin, waiting for the Owner (SUPER_OWNER) approval.
  PENDING
}

model Tenant {
  id                  String       @id @default(uuid(7)) @db.Uuid
  slug                String       @unique
  name                String
  kind                TenantKind   @default(BUSINESS)
  status              TenantStatus @default(ACTIVE)
  // Security policy: when true every user with a privileged role must use MFA.
  requireMfaForAdmins Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  // Set when the owner closes the account (data kept for the retention period).
  closedAt            DateTime?

  subscription   Subscription?
  brands         Brand[]
  invoices       Invoice[]
  branches       Branch[]
  users          User[]
  roles          Role[]
  sessions       Session[]
  devices        Device[]
  profile        TenantProfile?
  menuCategories MenuCategory[]
  modifierGroups ModifierGroup[]

  @@map("tenants")
}

model Branch {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @db.Uuid
  code         String
  name         String
  address      String?
  // Kitchen location for distance-based delivery pricing.
  lat          Float?
  lng          Float?
  phone        String?
  timezone     String    @default("Asia/Tashkent")
  currency     String    @default("UZS")
  isActive     Boolean   @default(true)
  // Kassa «TV ekrani» switch: the queue TVs of this branch show a pause screen.
  tvPaused     Boolean   @default(false)
  // Brand this branch trades under (null = the business's own name and menu).
  brandId      String?   @db.Uuid
  // Franchise partner operating this branch (null = company-owned).
  franchiseeId String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  brand           Brand?               @relation(fields: [tenantId, brandId], references: [tenantId, id], onDelete: Restrict)
  franchisee      Franchisee?          @relation(fields: [tenantId, franchiseeId], references: [tenantId, id], onDelete: Restrict)
  inspections     Inspection[]
  checklistRuns   ChecklistRun[]
  temperatureLogs TemperatureLog[]
  incidents       Incident[]
  handovers       ShiftHandover[]
  opsTasks        OpsTask[]
  stockBatches    StockBatch[]
  assets          Asset[]
  users           UserBranch[]
  devices         Device[]
  sessions        Session[]
  rooms           Room[]
  tables          DiningTable[]
  prices          BranchVariantPrice[]
  shifts          CashShift[]
  orders          Order[]
  warehouses      Warehouse[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, isActive])
  @@map("branches")
}

model User {
  id                 String     @id @default(uuid(7)) @db.Uuid
  tenantId           String     @db.Uuid
  username           String
  displayName        String
  phone              String?
  status             UserStatus @default(ACTIVE)
  isPlatformAdmin    Boolean    @default(false)
  // True grants access to every branch of the tenant; otherwise see UserBranch.
  allBranches        Boolean    @default(false)
  passwordHash       String?
  passwordChangedAt  DateTime?
  mustChangePassword Boolean    @default(false)
  pinHash            String?
  pinChangedAt       DateTime?
  mfaSecretEnc       String?
  mfaEnabledAt       DateTime?
  mfaLastStep        BigInt?
  failedLoginCount   Int        @default(0)
  lockedUntil        DateTime?
  failedPinCount     Int        @default(0)
  pinLockedUntil     DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  roles    UserRole[]
  branches UserBranch[]
  sessions Session[]

  @@unique([tenantId, username])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @db.Uuid
  // Stable key for system roles (owner, admin, cashier...). Null for custom roles.
  systemKey   String?
  name        String
  description String?
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  users  UserRole[]

  @@unique([tenantId, name])
  @@unique([tenantId, systemKey])
  @@unique([tenantId, id])
  @@map("roles")
}

model UserRole {
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())

  // Composite foreign keys make cross-tenant assignments impossible in the database.
  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  role Role @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([tenantId, roleId])
  @@map("user_roles")
}

model UserBranch {
  tenantId String @db.Uuid
  userId   String @db.Uuid
  branchId String @db.Uuid

  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)

  @@id([userId, branchId])
  @@index([tenantId, branchId])
  @@map("user_branches")
}

model Device {
  id             String       @id @default(uuid(7)) @db.Uuid
  tenantId       String       @db.Uuid
  branchId       String       @db.Uuid
  name           String
  tokenHash      String       @unique
  status         DeviceStatus @default(ACTIVE)
  registeredById String       @db.Uuid
  lastSeenAt     DateTime?
  // Reported by the installed app (heartbeat) for fleet monitoring.
  appVersion     String?
  userAgent      String?
  // Panel this terminal serves: CASHIER, KITCHEN, WAITER or OTHER (offline rules).
  panel          String       @default("OTHER")
  lastIp         String?
  createdAt      DateTime     @default(now())
  revokedAt      DateTime?
  // Switched off for a while by the restaurant Admin (no PIN sign-in until switched on).
  disabledAt     DateTime?
  // Employees allowed to sign in here by PIN (empty: everyone the panel allows).
  allowedUserIds String[]     @default([])

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch   Branch    @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  sessions Session[]

  @@index([tenantId, branchId])
  @@map("devices")
}

model Session {
  id            String     @id @default(uuid(7)) @db.Uuid
  tokenHash     String     @unique
  tenantId      String     @db.Uuid
  userId        String     @db.Uuid
  branchId      String?    @db.Uuid
  deviceId      String?    @db.Uuid
  authMethod    AuthMethod
  // False until the second factor is verified for MFA-enabled users.
  mfaVerified   Boolean    @default(false)
  reauthAt      DateTime?
  createdAt     DateTime   @default(now())
  lastSeenAt    DateTime   @default(now())
  idleExpiresAt DateTime
  expiresAt     DateTime
  revokedAt     DateTime?
  revokeReason  String?
  ipAddress     String?
  userAgent     String?

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User    @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([tenantId, createdAt])
  @@map("sessions")
}

// Append-only. A database trigger rejects UPDATE and DELETE (see migration).
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  tenantId    String?  @db.Uuid
  branchId    String?  @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String?
  entityId    String?
  outcome     String   @default("SUCCESS")
  data        Json?
  ipAddress   String?
  requestId   String?
  // Session (device) and role keys of the actor at the time of the action.
  sessionId   String?  @db.Uuid
  roles       String?
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, action, createdAt])
  @@index([tenantId, entityId])
  @@index([tenantId, actorUserId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Phase 3: restaurant configuration. Money is stored as integer amounts in the
// currency's smallest unit in use (so‘m for UZS); never floating point.

model TenantProfile {
  tenantId                String   @id @db.Uuid
  // Workflow configuration activated by the SUPER_OWNER (null: existing behaviour).
  workflow                Json?
  workflowVersion         Int      @default(0)
  legalName               String?
  taxId                   String?
  phone                   String?
  address                 String?
  receiptHeader           String?
  receiptFooter           String?
  // Percentage in basis points (1000 = 10%).
  serviceChargeBp         Int      @default(0)
  // When false, completing an order that would drive stock below zero is rejected.
  allowNegativeStock      Boolean  @default(true)
  // Public website and table-QR ordering (off until the owner enables it).
  publicOrdering          Boolean  @default(false)
  // Loyalty earn rate in basis points of the paid amount (0 = loyalty off).
  loyaltyEarnBp           Int      @default(0)
  // Tiers, every-Nth-purchase reward and birthday gift (see crm/loyalty-rules.ts).
  loyaltyRules            Json     @default("{}")
  // Expenses above this amount need approval (null = no limit).
  expenseApprovalLimit    Int?
  // Distance pricing: base fee, per-km fee, minimum, max distance, free-from subtotal.
  deliveryPricing         Json     @default("{}")
  // Fiscal (OFD) details: provider, TIN, terminal; the secret is encrypted separately.
  fiscalSettings          Json     @default("{}")
  fiscalCredentialsEnc    String?
  // Configurable labour rules (review for the applicable jurisdiction).
  overtimeAfterMinutes    Int      @default(480)
  overtimeMultiplierBp    Int      @default(15000)
  // Repairs at or above this cost (so‘m) need an approval before closing.
  repairApprovalThreshold Int      @default(1000000)
  // Receipt layout options (see settings.routes.ts receiptSettings).
  receiptSettings         Json     @default("{}")
  // Merchant QR payment (Paynet etc.): see settings.routes.ts qrPaymentSchema.
  qrPayment               Json     @default("{}")
  // Order routing: cashier confirmation before kitchen, prices on kitchen tickets.
  orderSettings           Json     @default("{}")
  updatedAt               DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("tenant_profiles")
}

model Room {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  branchId  String   @db.Uuid
  name      String
  // Workflow zone of the room's tables: HALL, VIP or BAR.
  kind      String   @default("HALL")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tables DiningTable[]
  branch Branch        @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([branchId, name])
  @@index([tenantId, branchId])
  @@map("rooms")
}

model DiningTable {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  branchId  String   @db.Uuid
  roomId    String   @db.Uuid
  name      String
  seats     Int      @default(4)
  // Opaque token for table QR menus (Phase 7); rotate to invalidate printed codes.
  qrToken   String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room   Room   @relation(fields: [tenantId, roomId], references: [tenantId, id], onDelete: Restrict)
  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)

  orders Order[]

  @@unique([tenantId, id])
  @@unique([branchId, name])
  @@index([tenantId, branchId])
  @@map("dining_tables")
}

model MenuCategory {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  parentId  String?  @db.Uuid
  // Kitchen station that prepares this category's items (null = every station).
  stationId String?  @db.Uuid
  // Brand-specific category (null = shared by every brand).
  brandId   String?  @db.Uuid
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parent   MenuCategory?   @relation("CategoryTree", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict)
  station  KitchenStation? @relation(fields: [tenantId, stationId], references: [tenantId, id], onDelete: Restrict)
  brand    Brand?          @relation(fields: [tenantId, brandId], references: [tenantId, id], onDelete: Restrict)
  children MenuCategory[]  @relation("CategoryTree")
  products Product[]

  @@unique([tenantId, id])
  @@index([tenantId, parentId])
  @@map("menu_categories")
}

model Product {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @db.Uuid
  categoryId      String    @db.Uuid
  name            String
  description     String?
  sku             String?
  barcode         String?
  imageUrl        String?
  allergens       String[]
  prepTimeMinutes Int?
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  version         Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  category       MenuCategory           @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  variants       ProductVariant[]
  modifierGroups ProductModifierGroup[]

  @@unique([tenantId, id])
  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, categoryId])
  @@map("products")
}

// Every product has at least one variant; simple products have a single default size.
model ProductVariant {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  productId String   @db.Uuid
  name      String
  price     Int
  // Internal cost: only returned to holders of menu.cost.view.
  cost      Int?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product      Product              @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)
  branchPrices BranchVariantPrice[]
  orderItems   OrderItem[]
  recipe       RecipeLine[]

  @@unique([tenantId, id])
  @@index([productId])
  @@map("product_variants")
}

model BranchVariantPrice {
  tenantId    String   @db.Uuid
  branchId    String   @db.Uuid
  variantId   String   @db.Uuid
  // Null keeps the base price and only overrides availability.
  price       Int?
  isAvailable Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  variant ProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Cascade)
  branch  Branch         @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)

  @@id([branchId, variantId])
  @@index([tenantId, variantId])
  @@map("branch_variant_prices")
}

model ModifierGroup {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  minSelect Int      @default(0)
  maxSelect Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  options  ModifierOption[]
  products ProductModifierGroup[]

  @@unique([tenantId, id])
  @@map("modifier_groups")
}

model ModifierOption {
  id        String  @id @default(uuid(7)) @db.Uuid
  tenantId  String  @db.Uuid
  groupId   String  @db.Uuid
  name      String
  price     Int     @default(0)
  cost      Int?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  group ModifierGroup @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([groupId])
  @@map("modifier_options")
}

model ProductModifierGroup {
  tenantId  String @db.Uuid
  productId String @db.Uuid
  groupId   String @db.Uuid
  sortOrder Int    @default(0)

  product Product       @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)
  group   ModifierGroup @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: Restrict)

  @@id([productId, groupId])
  @@map("product_modifier_groups")
}

// ---------------------------------------------------------------------------
// Phase 4: orders, payments and cashier shifts. Financial rows are never
// deleted; corrections are new rows (refunds, cancellations, cash movements).

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderChannel {
  POS
  WAITER
  QR
  WEB
  TELEGRAM
}

// DRAFT -> PLACED -> PREPARING -> READY -> SERVED -> COMPLETED; CANCELLED from
// DRAFT/PLACED. Transitions are enforced in modules/orders/state.ts.
enum OrderStatus {
  DRAFT
  // Online (QR/web) order waiting for staff approval.
  PENDING
  PLACED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum OrderItemStatus {
  ACTIVE
  CANCELLED
}

enum PaymentMethod {
  CASH
  // Loyalty points redeemed as payment (not money; excluded from cash totals).
  LOYALTY
  CARD
  CLICK
  PAYME
  UZUM
  // Merchant QR (e.g. Paynet) confirmed by the cashier after the payment arrives.
  QR
  OTHER
}

enum ShiftStatus {
  OPEN
  CLOSED
}

model CashShift {
  id           String      @id @default(uuid(7)) @db.Uuid
  tenantId     String      @db.Uuid
  branchId     String      @db.Uuid
  // Register identity: the device id, or "user:<id>" for browser sessions.
  registerKey  String
  deviceId     String?     @db.Uuid
  status       ShiftStatus @default(OPEN)
  openedById   String      @db.Uuid
  openedAt     DateTime    @default(now())
  openingCash  Int
  closedById   String?     @db.Uuid
  closedAt     DateTime?
  expectedCash Int?
  countedCash  Int?
  variance     Int?
  closeNote    String?

  branch        Branch         @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  cashMovements CashMovement[]
  payments      Payment[]
  refunds       Refund[]

  @@unique([tenantId, id])
  @@index([tenantId, branchId, openedAt])
  @@map("cash_shifts")
}

model CashMovement {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @db.Uuid
  shiftId     String   @db.Uuid
  // Positive = cash in (pay-in), negative = cash out (pay-out).
  amount      Int
  reason      String
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())

  shift CashShift @relation(fields: [tenantId, shiftId], references: [tenantId, id], onDelete: Restrict)

  @@index([shiftId])
  @@map("cash_movements")
}

model OrderCounter {
  branchId     String   @db.Uuid
  businessDate DateTime @db.Date
  lastNumber   Int      @default(0)

  @@id([branchId, businessDate])
  @@map("order_counters")
}

model Order {
  id                 String          @id @default(uuid(7)) @db.Uuid
  tenantId           String          @db.Uuid
  branchId           String          @db.Uuid
  // Short daily number shown on receipts and queue screens.
  number             Int
  businessDate       DateTime        @db.Date
  type               OrderType
  channel            OrderChannel    @default(POS)
  status             OrderStatus     @default(DRAFT)
  // 0 = normal, 1 = rush. Kitchen screens sort by priority, then age.
  priority           Int             @default(0)
  readyAt            DateTime?
  // Kitchen confirmation: a cook must accept a new ticket; it can also be refused.
  kitchenAcceptedAt   DateTime?
  kitchenAcceptedById String?         @db.Uuid
  kitchenRejectedAt   DateTime?
  kitchenRejectedById String?         @db.Uuid
  kitchenRejectReason String?
  tableId            String?         @db.Uuid
  customerName       String?
  customerPhone      String?
  deliveryAddress    String?
  // Address details / landmark ("mo‘ljal"), printed only on the courier handoff sheet.
  deliveryLandmark   String?
  // Customer point (GPS / map link) and the distance used for the fee.
  deliveryLat        Float?
  deliveryLng        Float?
  deliveryDistanceM  Int?
  note               String?
  subtotal           Int             @default(0)
  // Discount rule: percentage (basis points) and/or fixed amount, recomputed on change.
  discountBp         Int             @default(0)
  discountFixed      Int             @default(0)
  discountTotal      Int             @default(0)
  discountReason     String?
  serviceChargeBp    Int             @default(0)
  serviceCharge      Int             @default(0)
  total              Int             @default(0)
  paidTotal          Int             @default(0)
  refundedTotal      Int             @default(0)
  idempotencyKey     String
  // Customer-facing tracking link for online orders (random, unguessable).
  trackingToken      String?         @unique
  customerId         String?         @db.Uuid
  couponId           String?         @db.Uuid
  // Delivery: zone, fee (in so‘m, added to the total), courier and progress.
  deliveryZoneId     String?         @db.Uuid
  deliveryFee        Int             @default(0)
  courierId          String?         @db.Uuid
  deliveryStatus     DeliveryStatus?
  assignedAt         DateTime?
  pickedUpAt         DateTime?
  deliveredAt        DateTime?
  deliveryProof      String?
  deliveryFailReason String?
  // Courier handoff (stage 1) and cash collected on delivery (reconciled by cashier).
  handedOverById     String?         @db.Uuid
  onTheWayAt         DateTime?
  cashCollected      Int             @default(0)
  cashReconciledAt   DateTime?
  cashReconciledById String?         @db.Uuid
  // Telegram customer: chat to notify and the last status we told them about.
  telegramChatId     String?
  telegramNotified   String?
  createdById        String?         @db.Uuid
  version            Int             @default(1)
  // Customer receipts printed so far: from the second one on they are marked "NUSXA".
  receiptPrints      Int             @default(0)
  // Snapshot of the zone flow this order follows (null: no workflow); later changes
  // of the restaurant's workflow never alter it.
  workflow           Json?
  placedAt           DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  branch   Branch       @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  table    DiningTable? @relation(fields: [tableId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  events   OrderEvent[]
  payments Payment[]
  refunds  Refund[]

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@unique([branchId, businessDate, number])
  @@index([tenantId, branchId, status])
  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, customerId])
  @@index([tenantId, courierId, deliveryStatus])
  @@map("orders")
}

model OrderItem {
  id                  String          @id @default(uuid(7)) @db.Uuid
  tenantId            String          @db.Uuid
  orderId             String          @db.Uuid
  variantId           String          @db.Uuid
  // Snapshots: later menu changes never alter historical orders.
  productName         String
  variantName         String
  unitPrice           Int
  unitCost            Int?
  modifiers           Json            @default("[]")
  modifiersTotal      Int             @default(0)
  // Set (combo) contents snapshot: [{ name, quantity }].
  components          Json            @default("[]")
  quantity            Int
  lineTotal           Int
  note                String?
  status              OrderItemStatus @default(ACTIVE)
  // Kitchen routing snapshot and preparation progress.
  stationId           String?         @db.Uuid
  prepTimeMinutes     Int?
  kitchenStatus       KitchenStatus   @default(QUEUED)
  prepStartedAt       DateTime?
  readyAt             DateTime?
  // Set when a kitchen ticket was queued for this item, so items print exactly once.
  kitchenPrintedAt    DateTime?
  // A cancelled item that was already printed gets a "DIQQAT! CHEK YANGILANDI" ticket once.
  cancelPrintedAt     DateTime?
  // Cancelling an item the kitchen already started waits for the cook to confirm.
  cancelRequestedAt   DateTime?
  cancelRequestedById String?         @db.Uuid
  cancelRequestReason String?
  cancelReason        String?
  createdById         String?         @db.Uuid
  createdAt           DateTime        @default(now())

  order   Order          @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Restrict)

  @@index([orderId])
  @@index([tenantId, variantId])
  @@map("order_items")
}

// Append-only order history (status changes, edits, payments).
model OrderEvent {
  id        BigInt   @id @default(autoincrement())
  tenantId  String   @db.Uuid
  orderId   String   @db.Uuid
  type      String
  data      Json?
  actorId   String?  @db.Uuid
  createdAt DateTime @default(now())

  order Order @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)

  @@index([orderId, id])
  @@map("order_events")
}

model Payment {
  id             String        @id @default(uuid(7)) @db.Uuid
  tenantId       String        @db.Uuid
  branchId       String        @db.Uuid
  orderId        String        @db.Uuid
  shiftId        String?       @db.Uuid
  method         PaymentMethod
  amount         Int
  // Cash only: amount handed over and change returned.
  tendered       Int?
  change         Int?
  // External terminal or provider reference (card slip number, provider transaction id).
  reference      String?
  idempotencyKey String
  createdById    String?       @db.Uuid
  createdAt      DateTime      @default(now())

  order   Order      @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  shift   CashShift? @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([orderId])
  @@index([shiftId])
  @@map("payments")
}

model Refund {
  id           String        @id @default(uuid(7)) @db.Uuid
  tenantId     String        @db.Uuid
  orderId      String        @db.Uuid
  paymentId    String        @db.Uuid
  shiftId      String?       @db.Uuid
  method       PaymentMethod
  amount       Int
  reason       String
  approvedById String        @db.Uuid
  createdAt    DateTime      @default(now())

  order   Order      @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  payment Payment    @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Restrict)
  shift   CashShift? @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([shiftId])
  @@map("refunds")
}

// ---------------------------------------------------------------------------
// Phase 5: kitchen routing, kitchen statuses and printing.

enum KitchenStatus {
  QUEUED
  PREPARING
  READY
  SERVED
}

enum PrinterKind {
  RECEIPT
  KITCHEN
}

enum PrintJobStatus {
  PENDING
  SENT
  FAILED
}

model KitchenStation {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @db.Uuid
  name           String
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  // Ticket layout for this department (header/footer, large items, copies...).
  ticketTemplate Json     @default("{}")
  createdAt      DateTime @default(now())

  categories MenuCategory[]
  printers   Printer[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@map("kitchen_stations")
}

// Network (raw TCP, ESC/POS) printers reachable from the API host or a local agent.
model Printer {
  id                String      @id @default(uuid(7)) @db.Uuid
  tenantId          String      @db.Uuid
  branchId          String      @db.Uuid
  name              String
  kind              PrinterKind
  stationId         String?     @db.Uuid
  host              String
  port              Int         @default(9100)
  isActive          Boolean     @default(true)
  // Jobs that keep failing here are copied once to this printer.
  fallbackPrinterId String?     @db.Uuid
  // Paper width in mm (58 = 32 columns, 80 = 48 columns).
  paperWidth        Int         @default(80)
  createdAt         DateTime    @default(now())

  station KitchenStation? @relation(fields: [tenantId, stationId], references: [tenantId, id], onDelete: Restrict)
  jobs    PrintJob[]

  @@unique([tenantId, id])
  @@index([tenantId, branchId])
  @@map("printers")
}

model PrintJob {
  id             String         @id @default(uuid(7)) @db.Uuid
  tenantId       String         @db.Uuid
  printerId      String         @db.Uuid
  orderId        String?        @db.Uuid
  kind           PrinterKind
  payload        Bytes
  status         PrintJobStatus @default(PENDING)
  attempts       Int            @default(0)
  lastError      String?
  nextTryAt      DateTime       @default(now())
  createdAt      DateTime       @default(now())
  sentAt         DateTime?
  // NEW (first ticket), UPDATE (changed order), REPRINT or a fallback copy.
  purpose        String         @default("NEW")
  fallbackFromId String?        @db.Uuid

  printer Printer @relation(fields: [tenantId, printerId], references: [tenantId, id], onDelete: Cascade)

  @@index([status, nextTryAt])
  @@map("print_jobs")
}

// ---------------------------------------------------------------------------
// Phase 6: warehouse, purchasing and recipes. Quantities are exact decimals in the
// item's base unit (grams, millilitres or pieces); costs are so‘m per base unit.

enum BaseUnit {
  G
  ML
  PCS
}

enum StockMovementType {
  RECEIPT
  // Goods sent back to the supplier.
  SUPPLIER_RETURN
  SALE
  WASTE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  STOCKTAKE
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

model StockItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  sku       String?
  baseUnit  BaseUnit
  // Low-stock alert threshold per warehouse, in base units.
  minStock  Decimal  @default(0) @db.Decimal(14, 3)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units     StockUnit[]
  balances  StockBalance[]
  movements StockMovement[]
  recipes   RecipeLine[]
  batches   StockBatch[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@unique([tenantId, sku])
  @@map("stock_items")
}

// Packaging units, e.g. "kg" = 1000 g, "qop (25 kg)" = 25000 g, "quti (24 dona)" = 24 pcs.
model StockUnit {
  id          String  @id @default(uuid(7)) @db.Uuid
  tenantId    String  @db.Uuid
  stockItemId String  @db.Uuid
  name        String
  factor      Decimal @db.Decimal(14, 3)

  stockItem StockItem @relation(fields: [tenantId, stockItemId], references: [tenantId, id], onDelete: Cascade)

  @@unique([stockItemId, name])
  @@map("stock_units")
}

model Warehouse {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  branchId  String   @db.Uuid
  name      String
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  branch    Branch          @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  balances  StockBalance[]
  movements StockMovement[]

  @@unique([tenantId, id])
  @@unique([branchId, name])
  @@map("warehouses")
}

model StockBalance {
  tenantId    String   @db.Uuid
  warehouseId String   @db.Uuid
  stockItemId String   @db.Uuid
  quantity    Decimal  @default(0) @db.Decimal(14, 3)
  // Weighted average cost per base unit.
  avgCost     Decimal  @default(0) @db.Decimal(14, 4)
  updatedAt   DateTime @updatedAt

  warehouse Warehouse @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)
  stockItem StockItem @relation(fields: [tenantId, stockItemId], references: [tenantId, id], onDelete: Restrict)

  @@id([warehouseId, stockItemId])
  @@index([tenantId, stockItemId])
  @@map("stock_balances")
}

// Append-only inventory ledger; balances are derived from it transactionally.
model StockMovement {
  id            BigInt            @id @default(autoincrement())
  tenantId      String            @db.Uuid
  warehouseId   String            @db.Uuid
  stockItemId   String            @db.Uuid
  type          StockMovementType
  quantity      Decimal           @db.Decimal(14, 3)
  unitCost      Decimal           @db.Decimal(14, 4)
  balanceAfter  Decimal           @db.Decimal(14, 3)
  referenceType String?
  referenceId   String?
  reason        String?
  createdById   String?           @db.Uuid
  createdAt     DateTime          @default(now())

  warehouse Warehouse @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)
  stockItem StockItem @relation(fields: [tenantId, stockItemId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, warehouseId, createdAt])
  @@index([stockItemId, createdAt])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model Supplier {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  phone     String?
  taxId     String?
  note      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  purchases  Purchase[]
  payments   SupplierPayment[]
  agreements SupplierAgreement[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@map("suppliers")
}

model Purchase {
  id           String         @id @default(uuid(7)) @db.Uuid
  tenantId     String         @db.Uuid
  supplierId   String         @db.Uuid
  warehouseId  String         @db.Uuid
  status       PurchaseStatus @default(DRAFT)
  invoiceNo    String?
  note         String?
  // Money in so‘m.
  total        Int            @default(0)
  createdById  String         @db.Uuid
  receivedById String?        @db.Uuid
  receivedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  supplier Supplier       @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  lines    PurchaseLine[]

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
  @@map("purchases")
}

model PurchaseLine {
  id           String  @id @default(uuid(7)) @db.Uuid
  tenantId     String  @db.Uuid
  purchaseId   String  @db.Uuid
  stockItemId  String  @db.Uuid
  // Entered quantity and packaging unit, plus the converted base quantity.
  quantity     Decimal @db.Decimal(14, 3)
  unitName     String
  factor       Decimal @db.Decimal(14, 3)
  baseQuantity Decimal @db.Decimal(14, 3)
  // Price per entered unit and line total, in so‘m.
  unitPrice    Int
  lineTotal    Int

  purchase Purchase @relation(fields: [tenantId, purchaseId], references: [tenantId, id], onDelete: Cascade)

  @@index([purchaseId])
  @@map("purchase_lines")
}

model SupplierPayment {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @db.Uuid
  supplierId  String   @db.Uuid
  amount      Int
  note        String?
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())

  supplier Supplier @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)

  @@index([supplierId])
  @@map("supplier_payments")
}

// Ingredients consumed per sold unit of a product variant.
model RecipeLine {
  id          String  @id @default(uuid(7)) @db.Uuid
  tenantId    String  @db.Uuid
  variantId   String  @db.Uuid
  stockItemId String  @db.Uuid
  quantity    Decimal @db.Decimal(14, 3)

  variant   ProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Cascade)
  stockItem StockItem      @relation(fields: [tenantId, stockItemId], references: [tenantId, id], onDelete: Restrict)

  @@unique([variantId, stockItemId])
  @@map("recipe_lines")
}

// ---------------------------------------------------------------------------
// Phase 8: online payment providers and fiscal receipts.

enum PaymentProvider {
  PAYME
  CLICK
}

enum ProviderTxState {
  CREATED
  PERFORMED
  CANCELLED
}

enum FiscalStatus {
  NOT_CONFIGURED
  PENDING
  REGISTERED
  FAILED
}

// Merchant credentials per tenant and provider. Secrets are encrypted at rest and
// never returned by the API.
model PaymentProviderConfig {
  id             String          @id @default(uuid(7)) @db.Uuid
  tenantId       String          @db.Uuid
  provider       PaymentProvider
  merchantId     String
  serviceId      String?
  merchantUserId String?
  secretEnc      String
  isActive       Boolean         @default(true)
  testMode       Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  transactions ProviderTransaction[]

  @@unique([tenantId, provider])
  @@unique([tenantId, id])
  @@map("payment_provider_configs")
}

// Provider-side transaction lifecycle (Payme create/perform/cancel, Click prepare/complete).
model ProviderTransaction {
  id           String          @id @default(uuid(7)) @db.Uuid
  tenantId     String          @db.Uuid
  configId     String          @db.Uuid
  provider     PaymentProvider
  externalId   String
  orderId      String          @db.Uuid
  // Amount in so‘m.
  amount       Int
  state        ProviderTxState @default(CREATED)
  providerTime BigInt?
  createdAt    DateTime        @default(now())
  performedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason Int?
  paymentId    String?         @db.Uuid

  config PaymentProviderConfig @relation(fields: [tenantId, configId], references: [tenantId, id], onDelete: Restrict)

  @@unique([provider, externalId])
  @@index([tenantId, createdAt])
  @@index([orderId])
  @@map("provider_transactions")
}

// Fiscal registration attempts per order. Without a certified provider the status
// stays NOT_CONFIGURED and receipts are printed as non-fiscal.
model FiscalReceipt {
  id         String       @id @default(uuid(7)) @db.Uuid
  tenantId   String       @db.Uuid
  orderId    String       @db.Uuid
  status     FiscalStatus
  provider   String?
  fiscalSign String?
  qrUrl      String?
  error      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([orderId])
  @@index([tenantId, status])
  @@map("fiscal_receipts")
}

// ---------------------------------------------------------------------------
// Phase 9a: customers, loyalty, coupons and feedback.

enum LoyaltyEntryType {
  EARN
  REDEEM
  REVERSAL
  ADJUST
}

enum CouponKind {
  PERCENT
  FIXED
}

enum FeedbackStatus {
  NEW
  RESOLVED
}

// Customer profile keyed by normalized phone number within a tenant.
model Customer {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tenantId           String    @db.Uuid
  phone              String
  name               String?
  birthday           DateTime? @db.Date
  marketingConsent   Boolean   @default(false)
  consentAt          DateTime?
  notes              String?
  // Loyalty points; 1 point = 1 so‘m when redeemed.
  points             Int       @default(0)
  totalSpent         Int       @default(0)
  orderCount         Int       @default(0)
  lastOrderAt        DateTime?
  // Loyalty card / referral code (QR on the printed card).
  cardCode           String?
  referredById       String?   @db.Uuid
  referralRewardedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  loyalty LoyaltyEntry[]

  @@unique([tenantId, cardCode])
  @@unique([tenantId, phone])
  @@unique([tenantId, id])
  @@map("customers")
}

// Append-only loyalty ledger; customers.points mirrors its running balance.
model LoyaltyEntry {
  id           BigInt           @id @default(autoincrement())
  tenantId     String           @db.Uuid
  customerId   String           @db.Uuid
  orderId      String?          @db.Uuid
  paymentId    String?          @db.Uuid
  type         LoyaltyEntryType
  points       Int
  balanceAfter Int
  reason       String?
  createdById  String?          @db.Uuid
  createdAt    DateTime         @default(now())

  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)

  @@index([customerId, id])
  @@map("loyalty_entries")
}

model Coupon {
  id        String     @id @default(uuid(7)) @db.Uuid
  tenantId  String     @db.Uuid
  code      String
  kind      CouponKind
  // Percent in basis points or fixed amount in so‘m.
  value     Int
  minOrder  Int        @default(0)
  maxUses   Int?
  usedCount Int        @default(0)
  validFrom DateTime?
  validTo   DateTime?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@map("coupons")
}

// Customer feedback per order (CSAT); low ratings are complaints to resolve.
model Feedback {
  id           String         @id @default(uuid(7)) @db.Uuid
  tenantId     String         @db.Uuid
  branchId     String         @db.Uuid
  orderId      String         @unique @db.Uuid
  rating       Int
  comment      String?
  status       FeedbackStatus @default(NEW)
  resolution   String?
  resolvedById String?        @db.Uuid
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())

  @@index([tenantId, createdAt])
  @@map("feedback")
}

// ---------------------------------------------------------------------------
// Phase 9b: delivery zones, couriers and consent-based location.

enum DeliveryStatus {
  UNASSIGNED
  ASSIGNED
  // Handed to the courier after the cashier verified the pickup code.
  PICKED_UP
  ON_THE_WAY
  DELIVERED
  FAILED
  RETURNED
}

// One-time verification codes. Only an HMAC of the code is stored; codes expire,
// allow a few attempts and are consumed once.
enum OrderCodePurpose {
  // Telegram customer collects a takeaway order.
  PICKUP
  // Cashier -> courier handoff.
  HANDOFF
  // Courier -> customer delivery confirmation.
  DELIVERY
}

model OrderCode {
  id          String           @id @default(uuid(7)) @db.Uuid
  tenantId    String           @db.Uuid
  orderId     String           @db.Uuid
  purpose     OrderCodePurpose
  codeHash    String
  expiresAt   DateTime
  attempts    Int              @default(0)
  maxAttempts Int              @default(5)
  consumedAt  DateTime?
  revokedAt   DateTime?
  createdById String?          @db.Uuid
  createdAt   DateTime         @default(now())

  @@index([orderId, purpose])
  @@map("order_codes")
}

// Customer chats of the restaurant's Telegram bot (ordering conversation state).
model TelegramChat {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @db.Uuid
  chatId      String
  name        String?
  phone       String?
  // Conversation step and cart; never contains payment data.
  state       Json      @default("{}")
  lastOrderAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, chatId])
  @@map("telegram_chats")
}

model DeliveryZone {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @db.Uuid
  branchId   String   @db.Uuid
  name       String
  // Delivery fee and minimum order subtotal in so‘m.
  fee        Int
  minOrder   Int      @default(0)
  etaMinutes Int?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([branchId, name])
  @@unique([tenantId, id])
  @@map("delivery_zones")
}

// Courier preferences; location is stored only while the courier has consented.
model CourierProfile {
  userId          String    @id @db.Uuid
  tenantId        String    @db.Uuid
  locationConsent Boolean   @default(false)
  consentAt       DateTime?
  lat             Float?
  lng             Float?
  accuracy        Float?
  locationAt      DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([tenantId])
  @@map("courier_profiles")
}

// ---------------------------------------------------------------------------
// Phase 10: HR (attendance, schedules, payroll) and finance (expenses, closing).

enum PayType {
  NONE
  HOURLY
  MONTHLY
  // Rate per worked day / per attendance shift.
  DAILY
  SHIFT
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

enum AdjustmentType {
  BONUS
  PENALTY
  ADVANCE
  // Employee loan (not deducted) and its repayments (deducted from pay).
  LOAN
  REPAYMENT
}

model EmployeeProfile {
  userId           String    @id @db.Uuid
  tenantId         String    @db.Uuid
  position         String?
  payType          PayType   @default(NONE)
  // so‘m per hour (HOURLY) or per month (MONTHLY).
  rate             Int       @default(0)
  // Commissions on top of the base pay (waiters): per completed order, per distinct
  // customer and a share of net sales (basis points).
  perOrder         Int       @default(0)
  perCustomer      Int       @default(0)
  salesPercentBp   Int       @default(0)
  // Quality bonus when the average guest rating of their orders reaches the minimum.
  qualityBonus     Int       @default(0)
  qualityMinRating Float     @default(4.5)
  hireDate         DateTime? @db.Date
  updatedAt        DateTime  @updatedAt

  @@index([tenantId])
  @@map("employee_profiles")
}

model AttendanceRecord {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @db.Uuid
  branchId      String    @db.Uuid
  userId        String    @db.Uuid
  clockIn       DateTime
  clockOut      DateTime?
  note          String?
  // Terminal the shift was opened on (null: browser / older records).
  deviceId      String?   @db.Uuid
  correctedById String?   @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId, userId, clockIn])
  @@index([tenantId, branchId, clockIn])
  @@map("attendance_records")
}

model ScheduledShift {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  branchId  String   @db.Uuid
  userId    String   @db.Uuid
  startsAt  DateTime
  endsAt    DateTime
  note      String?
  createdAt DateTime @default(now())

  @@index([tenantId, branchId, startsAt])
  @@index([userId, startsAt])
  @@map("scheduled_shifts")
}

model PayrollPeriod {
  id           String        @id @default(uuid(7)) @db.Uuid
  tenantId     String        @db.Uuid
  startDate    DateTime      @db.Date
  endDate      DateTime      @db.Date
  status       PayrollStatus @default(DRAFT)
  approvedById String?       @db.Uuid
  approvedAt   DateTime?
  paidAt       DateTime?
  createdAt    DateTime      @default(now())

  lines PayrollLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, startDate, endDate])
  @@map("payroll_periods")
}

model PayrollLine {
  id              String  @id @default(uuid(7)) @db.Uuid
  tenantId        String  @db.Uuid
  periodId        String  @db.Uuid
  userId          String  @db.Uuid
  payType         PayType
  rate            Int
  workedMinutes   Int     @default(0)
  overtimeMinutes Int     @default(0)
  baseAmount      Int     @default(0)
  overtimeAmount  Int     @default(0)
  bonuses         Int     @default(0)
  penalties       Int     @default(0)
  advances        Int     @default(0)
  commission      Int     @default(0)
  total           Int     @default(0)

  period PayrollPeriod @relation(fields: [tenantId, periodId], references: [tenantId, id], onDelete: Cascade)

  @@unique([periodId, userId])
  @@map("payroll_lines")
}

// Bonuses, penalties and advances; applied to the payroll period containing their date.
model PayrollAdjustment {
  id          String         @id @default(uuid(7)) @db.Uuid
  tenantId    String         @db.Uuid
  userId      String         @db.Uuid
  type        AdjustmentType
  amount      Int
  date        DateTime       @db.Date
  reason      String
  // Paid out of the open cash shift (a cash movement was recorded).
  fromCash    Boolean        @default(false)
  createdById String         @db.Uuid
  createdAt   DateTime       @default(now())

  @@index([tenantId, userId, date])
  @@map("payroll_adjustments")
}

model Expense {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @db.Uuid
  branchId       String   @db.Uuid
  category       String
  amount         Int
  date           DateTime @db.Date
  note           String?
  // Who received the money (supplier, employee, utility).
  recipient      String?
  // Receipt photo/PDF (evidence_files).
  attachmentId   String?  @db.Uuid
  // Paid out of the open cash shift (a cash movement was recorded).
  fromCash       Boolean  @default(false)
  // APPROVED, PENDING (above the approval limit) or REJECTED; only approved count.
  approvalStatus String   @default("APPROVED")
  createdById    String   @db.Uuid
  createdAt      DateTime @default(now())

  @@index([tenantId, branchId, date])
  @@map("expenses")
}

// Closed months reject back-dated financial changes (expenses, payroll adjustments).
model ClosedPeriod {
  tenantId   String   @db.Uuid
  month      String
  closedById String   @db.Uuid
  closedAt   DateTime @default(now())

  @@id([tenantId, month])
  @@map("closed_periods")
}

// ---------------------------------------------------------------------------
// Phase 11: SaaS plans, subscriptions and invoices (platform-level billing).

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum InvoiceStatus {
  OPEN
  PAID
  VOID
}

model Plan {
  id           String   @id @default(uuid(7)) @db.Uuid
  code         String   @unique
  name         String
  // Prices in so‘m.
  monthlyPrice Int
  yearlyPrice  Int
  // Null means unlimited.
  maxBranches  Int?
  maxUsers     Int?
  maxDevices   Int?
  features     String[]
  trialDays    Int      @default(14)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                  String             @id @default(uuid(7)) @db.Uuid
  tenantId            String             @unique @db.Uuid
  planId              String             @db.Uuid
  status              SubscriptionStatus
  billingCycle        BillingCycle       @default(MONTHLY)
  trialEndsAt         DateTime?
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  // Set when billing suspended the tenant, so payment can reactivate it.
  suspendedForBilling Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan     Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices Invoice[]

  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

model Invoice {
  id             String        @id @default(uuid(7)) @db.Uuid
  number         BigInt        @default(autoincrement())
  tenantId       String        @db.Uuid
  subscriptionId String        @db.Uuid
  planCode       String
  periodStart    DateTime
  periodEnd      DateTime
  amount         Int
  status         InvoiceStatus @default(OPEN)
  dueDate        DateTime
  paidAt         DateTime?
  reference      String?
  createdAt      DateTime      @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@unique([number])
  @@unique([subscriptionId, periodStart])
  @@index([tenantId, createdAt])
  @@index([status, dueDate])
  @@map("invoices")
}

// ---------------------------------------------------------------------------
// Phase 12: brands (multi-brand organizations).

model Brand {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @db.Uuid
  code          String
  name          String
  logoUrl       String?
  // Hex colour used on the storefront and receipts.
  primaryColor  String?
  receiptHeader String?
  receiptFooter String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branches   Branch[]
  categories MenuCategory[]
  contracts  FranchiseContract[]
  agreements SupplierAgreement[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@map("brands")
}

// ---------------------------------------------------------------------------
// Phase 12b: franchise partners, contracts, royalties, inspections, agreements.

enum FranchiseeStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
  TERMINATED
}

model Franchisee {
  id          String           @id @default(uuid(7)) @db.Uuid
  tenantId    String           @db.Uuid
  name        String
  legalName   String?
  taxId       String?
  contactName String?
  phone       String?
  email       String?
  status      FranchiseeStatus @default(ONBOARDING)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  branches  Branch[]
  contracts FranchiseContract[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@map("franchisees")
}

enum ContractStatus {
  DRAFT
  ACTIVE
  TERMINATED
}

model FranchiseContract {
  id                String         @id @default(uuid(7)) @db.Uuid
  tenantId          String         @db.Uuid
  franchiseeId      String         @db.Uuid
  // Brand licensed by the contract (null = every brand of the franchisee's branches).
  brandId           String?        @db.Uuid
  number            String
  territory         String
  // Exclusive territories cannot overlap for the same brand while active.
  exclusive         Boolean        @default(false)
  startDate         DateTime       @db.Date
  endDate           DateTime?      @db.Date
  // Fees in basis points of net sales (500 = 5%).
  royaltyBp         Int
  marketingFeeBp    Int            @default(0)
  // Minimum monthly royalty in so‘m (the difference is charged as a top-up).
  minimumMonthlyFee Int            @default(0)
  status            ContractStatus @default(DRAFT)
  activatedAt       DateTime?
  terminatedAt      DateTime?
  terminationReason String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  franchisee Franchisee         @relation(fields: [tenantId, franchiseeId], references: [tenantId, id], onDelete: Restrict)
  brand      Brand?             @relation(fields: [tenantId, brandId], references: [tenantId, id], onDelete: Restrict)
  statements RoyaltyStatement[]

  @@unique([tenantId, number])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("franchise_contracts")
}

enum StatementStatus {
  DRAFT
  ISSUED
  PAID
}

model RoyaltyStatement {
  id           String          @id @default(uuid(7)) @db.Uuid
  tenantId     String          @db.Uuid
  contractId   String          @db.Uuid
  // Calendar month, YYYY-MM.
  month        String
  grossSales   Int
  refunds      Int
  netSales     Int
  royalty      Int
  marketingFee Int
  minimumTopUp Int
  total        Int
  status       StatementStatus @default(DRAFT)
  issuedAt     DateTime?
  paidAt       DateTime?
  reference    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  contract FranchiseContract @relation(fields: [tenantId, contractId], references: [tenantId, id], onDelete: Restrict)

  @@unique([contractId, month])
  @@index([tenantId, month])
  @@map("royalty_statements")
}

model Inspection {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @db.Uuid
  branchId    String   @db.Uuid
  inspectorId String   @db.Uuid
  inspectedAt DateTime
  // Checklist results: [{ label, passed, note }].
  items       Json
  // Percentage of passed checklist items (0–100).
  score       Int
  notes       String?
  createdAt   DateTime @default(now())

  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, branchId, inspectedAt])
  @@map("inspections")
}

model SupplierAgreement {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @db.Uuid
  supplierId       String    @db.Uuid
  // Brand the agreement applies to (null = the whole organization).
  brandId          String?   @db.Uuid
  title            String
  startDate        DateTime  @db.Date
  endDate          DateTime? @db.Date
  paymentTermsDays Int?
  terms            String?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  supplier Supplier @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  brand    Brand?   @relation(fields: [tenantId, brandId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, supplierId])
  @@map("supplier_agreements")
}

// ---------------------------------------------------------------------------
// Phase 13a: restaurant operations and food safety.

model SopDocument {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @db.Uuid
  title       String
  category    String
  body        String
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  updatedById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  revisions SopRevision[]

  @@unique([tenantId, id])
  @@index([tenantId, category])
  @@map("sop_documents")
}

// Every published SOP version is kept (append-only) for compliance history.
model SopRevision {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @db.Uuid
  sopId       String   @db.Uuid
  version     Int
  title       String
  body        String
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())

  sop SopDocument @relation(fields: [tenantId, sopId], references: [tenantId, id], onDelete: Restrict)

  @@unique([sopId, version])
  @@map("sop_revisions")
}

enum ChecklistKind {
  OPENING
  CLOSING
  CLEANING
  HACCP
  OTHER
}

model ChecklistTemplate {
  id        String        @id @default(uuid(7)) @db.Uuid
  tenantId  String        @db.Uuid
  // Null = every branch.
  branchId  String?       @db.Uuid
  name      String
  kind      ChecklistKind
  // [{ label, requiresPhoto }]
  items     Json
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  runs ChecklistRun[]

  @@unique([tenantId, id])
  @@map("checklist_templates")
}

enum ChecklistRunStatus {
  IN_PROGRESS
  COMPLETED
  APPROVED
}

model ChecklistRun {
  id            String             @id @default(uuid(7)) @db.Uuid
  tenantId      String             @db.Uuid
  branchId      String             @db.Uuid
  templateId    String             @db.Uuid
  businessDate  DateTime           @db.Date
  status        ChecklistRunStatus @default(IN_PROGRESS)
  // [{ label, requiresPhoto, done, note, evidenceId }]
  results       Json
  startedById   String             @db.Uuid
  completedById String?            @db.Uuid
  completedAt   DateTime?
  approvedById  String?            @db.Uuid
  approvedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  template ChecklistTemplate @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: Restrict)
  branch   Branch            @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)

  @@unique([templateId, branchId, businessDate])
  @@index([tenantId, branchId, businessDate])
  @@map("checklist_runs")
}

// Photo evidence (JPEG/PNG/WebP up to 2 MB), stored in the database so it is
// covered by the same backups and tenant isolation as the records it proves.
model EvidenceFile {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @db.Uuid
  branchId     String?  @db.Uuid
  uploadedById String   @db.Uuid
  contentType  String
  size         Int
  sha256       String
  data         Bytes
  createdAt    DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("evidence_files")
}

model TemperatureLog {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @db.Uuid
  branchId     String   @db.Uuid
  // Measuring point, e.g. a fridge or a cooked product core temperature.
  point        String
  value        Decimal  @db.Decimal(5, 1)
  minValue     Decimal  @db.Decimal(5, 1)
  maxValue     Decimal  @db.Decimal(5, 1)
  outOfRange   Boolean
  note         String?
  recordedById String   @db.Uuid
  recordedAt   DateTime @default(now())
  incidentId   String?  @db.Uuid

  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, branchId, recordedAt])
  @@map("temperature_logs")
}

enum IncidentType {
  FOOD_SAFETY
  EQUIPMENT
  INJURY
  CUSTOMER
  SECURITY
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

model Incident {
  id               String           @id @default(uuid(7)) @db.Uuid
  tenantId         String           @db.Uuid
  branchId         String           @db.Uuid
  type             IncidentType
  severity         IncidentSeverity
  title            String
  description      String
  status           IncidentStatus   @default(OPEN)
  reportedById     String?          @db.Uuid
  rootCause        String?
  correctiveAction String?
  preventiveAction String?
  evidenceIds      String[]
  resolvedById     String?          @db.Uuid
  resolvedAt       DateTime?
  closedById       String?          @db.Uuid
  closedAt         DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, branchId, status])
  @@map("incidents")
}

model ShiftHandover {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @db.Uuid
  branchId         String    @db.Uuid
  fromUserId       String    @db.Uuid
  notes            String
  openIssues       String?
  acknowledgedById String?   @db.Uuid
  acknowledgedAt   DateTime?
  createdAt        DateTime  @default(now())

  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, branchId, createdAt])
  @@map("shift_handovers")
}

enum TaskRecurrence {
  NONE
  DAILY
  WEEKLY
}

enum OpsTaskStatus {
  OPEN
  DONE
  CANCELLED
}

model OpsTask {
  id                String         @id @default(uuid(7)) @db.Uuid
  tenantId          String         @db.Uuid
  branchId          String         @db.Uuid
  title             String
  description       String?
  assigneeId        String?        @db.Uuid
  dueAt             DateTime
  recurrence        TaskRecurrence @default(NONE)
  requiresPhoto     Boolean        @default(false)
  status            OpsTaskStatus  @default(OPEN)
  // Null when created by an automation (e.g. a due maintenance plan).
  createdById       String?        @db.Uuid
  completedById     String?        @db.Uuid
  completedAt       DateTime?
  evidenceId        String?        @db.Uuid
  note              String?
  maintenancePlanId String?        @db.Uuid
  createdAt         DateTime       @default(now())

  branch          Branch           @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  maintenancePlan MaintenancePlan? @relation(fields: [tenantId, maintenancePlanId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, branchId, status, dueAt])
  @@map("ops_tasks")
}

enum BatchStatus {
  ACTIVE
  QUARANTINED
  RECALLED
  DISPOSED
}

// Lot traceability register: which supplier lot arrived where and when.
model StockBatch {
  id                String      @id @default(uuid(7)) @db.Uuid
  tenantId          String      @db.Uuid
  stockItemId       String      @db.Uuid
  branchId          String      @db.Uuid
  supplierId        String?     @db.Uuid
  lotNumber         String
  receivedAt        DateTime
  expiresAt         DateTime?   @db.Date
  quantity          Decimal     @db.Decimal(14, 3)
  status            BatchStatus @default(ACTIVE)
  statusReason      String?
  statusChangedById String?     @db.Uuid
  statusChangedAt   DateTime?
  createdById       String      @db.Uuid
  createdAt         DateTime    @default(now())

  stockItem StockItem @relation(fields: [tenantId, stockItemId], references: [tenantId, id], onDelete: Restrict)
  branch    Branch    @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, status, expiresAt])
  @@index([tenantId, stockItemId, lotNumber])
  @@map("stock_batches")
}

// ---------------------------------------------------------------------------
// Phase 13b: assets and maintenance, training, approvals.

enum AssetStatus {
  ACTIVE
  IN_REPAIR
  RETIRED
}

model Asset {
  id            String      @id @default(uuid(7)) @db.Uuid
  tenantId      String      @db.Uuid
  branchId      String      @db.Uuid
  // Printed as a QR/barcode label; unique within the tenant.
  tag           String
  name          String
  category      String
  serialNumber  String?
  manufacturer  String?
  model         String?
  location      String?
  purchaseDate  DateTime?   @db.Date
  purchaseCost  Int?
  warrantyUntil DateTime?   @db.Date
  status        AssetStatus @default(ACTIVE)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  branch  Branch            @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  plans   MaintenancePlan[]
  tickets RepairTicket[]
  events  AssetEvent[]

  @@unique([tenantId, tag])
  @@unique([tenantId, id])
  @@index([tenantId, branchId])
  @@map("assets")
}

model MaintenancePlan {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @db.Uuid
  assetId      String    @db.Uuid
  title        String
  intervalDays Int
  nextDueAt    DateTime  @db.Date
  lastDoneAt   DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  asset Asset     @relation(fields: [tenantId, assetId], references: [tenantId, id], onDelete: Restrict)
  tasks OpsTask[]

  @@unique([tenantId, id])
  @@index([tenantId, isActive, nextDueAt])
  @@map("maintenance_plans")
}

enum RepairStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum RepairPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model RepairTicket {
  id                String         @id @default(uuid(7)) @db.Uuid
  tenantId          String         @db.Uuid
  assetId           String         @db.Uuid
  title             String
  description       String
  priority          RepairPriority @default(NORMAL)
  status            RepairStatus   @default(OPEN)
  reportedById      String         @db.Uuid
  technician        String?
  serviceContractId String?        @db.Uuid
  // [{ name, quantity, cost }] spare parts used.
  parts             Json           @default("[]")
  laborCost         Int            @default(0)
  partsCost         Int            @default(0)
  resolution        String?
  downtimeStart     DateTime       @default(now())
  downtimeEnd       DateTime?
  approvalId        String?        @db.Uuid
  closedById        String?        @db.Uuid
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  asset Asset @relation(fields: [tenantId, assetId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, status])
  @@map("repair_tickets")
}

// Lifecycle history of an asset (append-only).
model AssetEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  assetId   String   @db.Uuid
  type      String
  note      String?
  cost      Int?
  passed    Boolean?
  actorId   String?  @db.Uuid
  createdAt DateTime @default(now())

  asset Asset @relation(fields: [tenantId, assetId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, assetId, createdAt])
  @@map("asset_events")
}

model ServiceContract {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @db.Uuid
  vendor    String
  phone     String?
  scope     String
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
  cost      Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId, isActive])
  @@map("service_contracts")
}

model Course {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @db.Uuid
  title        String
  description  String?
  // Learning material: text or an HTTPS link.
  content      String?
  // Certification validity; null = never expires.
  validityDays Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  records TrainingRecord[]

  @@unique([tenantId, title])
  @@unique([tenantId, id])
  @@map("courses")
}

// Completed training (certificate) evidence; append-only.
model TrainingRecord {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @db.Uuid
  courseId     String    @db.Uuid
  userId       String    @db.Uuid
  completedAt  DateTime
  expiresAt    DateTime?
  score        Int?
  evidenceId   String?   @db.Uuid
  note         String?
  recordedById String    @db.Uuid
  createdAt    DateTime  @default(now())

  course Course @relation(fields: [tenantId, courseId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, userId])
  @@index([tenantId, expiresAt])
  @@map("training_records")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// Generic approval requests (e.g. repair costs above the configured threshold).
model ApprovalRequest {
  id            String         @id @default(uuid(7)) @db.Uuid
  tenantId      String         @db.Uuid
  branchId      String?        @db.Uuid
  type          String
  entityType    String
  entityId      String
  amount        Int?
  reason        String
  status        ApprovalStatus @default(PENDING)
  requestedById String         @db.Uuid
  decidedById   String?        @db.Uuid
  decidedAt     DateTime?
  comment       String?
  createdAt     DateTime       @default(now())

  @@index([tenantId, status])
  @@index([entityType, entityId])
  @@map("approval_requests")
}

// ---------------------------------------------------------------------------
// Phase 14a: notifications (Telegram) with a durable outbox.

model TelegramConfig {
  tenantId          String    @id @db.Uuid
  // Bot token, AES-GCM encrypted; never returned by the API.
  botTokenEnc       String
  botUsername       String?
  // Secret expected in X-Telegram-Bot-Api-Secret-Token on webhook calls.
  webhookSecretHash String
  isActive          Boolean   @default(true)
  // Local hour (Asia/Tashkent) for the daily summary; null disables it.
  dailySummaryHour  Int?      @default(22)
  lastDailySummary  DateTime? @db.Date
  updatedAt         DateTime  @updatedAt

  // Customers can order through the bot; orders go to this branch.
  ordersEnabled Boolean @default(false)
  orderBranchId String? @db.Uuid
  // Long-polling offset (self-hosted installs without a public HTTPS address).
  updateOffset  BigInt  @default(0)

  @@map("telegram_configs")
}

model NotificationSubscriber {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @db.Uuid
  name      String
  // Telegram chat id; null until the subscriber links the bot with the code.
  chatId    String?
  linkCode  String?   @unique
  // Event keys this subscriber receives.
  events    String[]
  // Null = every branch.
  branchIds String[]
  isActive  Boolean   @default(true)
  linkedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, id])
  @@unique([tenantId, chatId])
  @@map("notification_subscribers")
}

model NotificationTemplate {
  tenantId  String   @db.Uuid
  event     String
  body      String
  updatedAt DateTime @updatedAt

  @@id([tenantId, event])
  @@map("notification_templates")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model NotificationJob {
  id           String             @id @default(uuid(7)) @db.Uuid
  tenantId     String             @db.Uuid
  subscriberId String             @db.Uuid
  event        String
  text         String
  status       NotificationStatus @default(PENDING)
  attempts     Int                @default(0)
  lastError    String?
  nextTryAt    DateTime           @default(now())
  sentAt       DateTime?
  createdAt    DateTime           @default(now())

  @@index([status, nextTryAt])
  @@index([tenantId, createdAt])
  @@map("notification_jobs")
}

// ---------------------------------------------------------------------------
// Phase 14b: developer platform (API keys and signed webhooks).

model ApiKey {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @db.Uuid
  name        String
  // First characters shown in the UI to recognise a key; the key itself is never stored.
  prefix      String
  keyHash     String    @unique
  scopes      String[]
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())

  @@index([tenantId])
  @@map("api_keys")
}

model WebhookEndpoint {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  url       String
  // HMAC signing secret, AES-GCM encrypted.
  secretEnc String
  events    String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@unique([tenantId, id])
  @@map("webhook_endpoints")
}

enum WebhookDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model WebhookDelivery {
  id             String                @id @default(uuid(7)) @db.Uuid
  tenantId       String                @db.Uuid
  endpointId     String                @db.Uuid
  event          String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  responseStatus Int?
  lastError      String?
  nextTryAt      DateTime              @default(now())
  sentAt         DateTime?
  createdAt      DateTime              @default(now())

  endpoint WebhookEndpoint @relation(fields: [tenantId, endpointId], references: [tenantId, id], onDelete: Restrict)

  @@index([status, nextTryAt])
  @@index([endpointId, createdAt])
  @@map("webhook_deliveries")
}

// ---------------------------------------------------------------------------
// Sets (combos): one product sold at one price, made of other menu items.

model ComboComponent {
  id                 String @id @default(uuid(7)) @db.Uuid
  tenantId           String @db.Uuid
  // The set's own variant (its price is the set price).
  variantId          String @db.Uuid
  componentVariantId String @db.Uuid
  quantity           Int    @default(1)
  sortOrder          Int    @default(0)

  @@index([tenantId, variantId])
  @@map("combo_components")
}

// Licence of a self-hosted (desktop) install, signed by the vendor.
model AppLicense {
  id             Int       @id @default(1)
  key            String
  // Highest time ever observed; moving the clock back does not extend a licence.
  lastSeenAt     DateTime  @default(now())
  // Remote control by the vendor (signed status document fetched over the internet).
  remoteBlocked  Boolean   @default(false)
  statusIssuedAt DateTime?
  updatedAt      DateTime  @updatedAt

  @@map("app_license")
}

// Goods returned to a supplier: stock goes down and the supplier debt is reduced.
model SupplierReturn {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @db.Uuid
  supplierId  String   @db.Uuid
  purchaseId  String?  @db.Uuid
  warehouseId String   @db.Uuid
  // [{ stockItemId, quantity (base unit), amount }]
  lines       Json
  total       Int
  reason      String
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())

  @@index([tenantId, supplierId])
  @@map("supplier_returns")
}

// Staff ask for stock (e.g. the kitchen runs low); a manager approves or rejects,
// approved requests become the shopping list and are closed by a purchase.
model StockRequest {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @db.Uuid
  branchId      String    @db.Uuid
  // [{ stockItemId, quantity, unitName }]
  items         Json
  note          String?
  // PENDING, APPROVED, REJECTED, FULFILLED
  status        String    @default("PENDING")
  requestedById String    @db.Uuid
  decidedById   String?   @db.Uuid
  decidedAt     DateTime?
  comment       String?
  createdAt     DateTime  @default(now())

  @@index([tenantId, branchId, status])
  @@map("stock_requests")
}

// ---------------------------------------------------------------------------
// SUPER_OWNER central control (additive). The central server (this backend run as
// the control plane) owns customers, licences, activations and policies; customer
// installs hold a signed, expiring grant and never the signing key.

enum ControlOwnerStatus {
  ACTIVE
  DISABLED
}

enum ControlDeviceStatus {
  PENDING
  APPROVED
  REVOKED
}

// Separate account space from restaurant users: owners never share credentials,
// sessions or roles with any tenant.
model ControlOwner {
  id                String             @id @default(uuid(7)) @db.Uuid
  email             String             @unique
  displayName       String
  passwordHash      String
  mfaSecretEnc      String?
  mfaEnabledAt      DateTime?
  mfaLastStep       BigInt?
  status            ControlOwnerStatus @default(ACTIVE)
  failedLoginCount  Int                @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  // Hash of the one-time recovery key (account recovery from a trusted computer only).
  recoveryHash      String?
  recoveryCreatedAt DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  devices  ControlOwnerDevice[]
  sessions ControlOwnerSession[]

  @@map("control_owners")
}

// An Owner application installation (EXE) holds a private key in OS secure storage;
// the owner can only sign in from an approved device.
model ControlOwnerDevice {
  id           String              @id @default(uuid(7)) @db.Uuid
  ownerId      String              @db.Uuid
  label        String
  publicKey    String
  fingerprint  String              @unique
  status       ControlDeviceStatus @default(PENDING)
  approvedAt   DateTime?
  approvedById String?             @db.Uuid
  // Set after a successful sign-in with a 2FA code on this computer: later sign-ins
  // from it need the password and the device key only.
  trustedAt    DateTime?
  lastSeenAt   DateTime?
  lastIp       String?
  createdAt    DateTime            @default(now())

  owner    ControlOwner          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sessions ControlOwnerSession[]

  @@index([ownerId, status])
  @@map("control_owner_devices")
}

model ControlOwnerSession {
  id            String    @id @default(uuid(7)) @db.Uuid
  tokenHash     String    @unique
  ownerId       String    @db.Uuid
  deviceId      String    @db.Uuid
  mfaVerified   Boolean   @default(false)
  reauthAt      DateTime?
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  idleExpiresAt DateTime
  expiresAt     DateTime
  revokedAt     DateTime?
  revokeReason  String?
  ipAddress     String?
  userAgent     String?

  owner  ControlOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  device ControlOwnerDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([ownerId, revokedAt])
  @@map("control_owner_sessions")
}

enum ControlCustomerStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

// A restaurant business under central control (a tenant of the SUPER_OWNER).
model ControlCustomer {
  id             String                @id @default(uuid(7)) @db.Uuid
  name           String
  contactName    String?
  phone          String?
  note           String?
  status         ControlCustomerStatus @default(ACTIVE)
  // Cloud-hosted tenant this customer corresponds to, when it runs on this server.
  tenantId       String?               @unique @db.Uuid
  // Local tenant of the first activated install; later activations must match.
  boundTenantKey String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  licenses    ControlLicense[]
  activations ControlActivation[]
  workflows   ControlWorkflow[]
  branches    ControlBranch[]
  payments    ControlPayment[]
  policy      ControlPolicy?
  syncOps     ControlSyncOp[]

  @@map("control_customers")
}

enum ControlLicenseStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

model ControlLicense {
  id          String               @id @default(uuid(7)) @db.Uuid
  customerId  String               @db.Uuid
  // HMAC-SHA256 of the normalized key; the plaintext key is shown once at issue.
  keyHash     String               @unique
  keyHint     String
  status      ControlLicenseStatus @default(ACTIVE)
  startsAt    DateTime             @default(now())
  expiresAt   DateTime
  // Computers (cashier hosts) that may be activated with this licence.
  maxInstalls Int                  @default(1)
  // Registered terminals (kitchen, waiter phones); null = unlimited.
  maxDevices  Int?
  maxBranches Int?
  maxUsers    Int?
  features    String[]
  note        String?
  renewedAt   DateTime?
  suspendedAt DateTime?
  revokedAt   DateTime?
  // Trial: lasts exactly this many hours from the first server-authorised activation.
  // expiresAt is a claim deadline until then and the exact end afterwards.
  trialHours     Int?
  trialStartedAt DateTime?
  createdById String?              @db.Uuid
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  customer    ControlCustomer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  activations ControlActivation[]
  payments    ControlPayment[]

  @@index([customerId, status])
  @@map("control_licenses")
}

model ControlPayment {
  id           String   @id @default(uuid(7)) @db.Uuid
  customerId   String   @db.Uuid
  licenseId    String?  @db.Uuid
  amount       Int
  currency     String   @default("UZS")
  method       String   @default("TRANSFER")
  // Months added to the licence by this payment (0 = record only).
  periodMonths Int      @default(0)
  reference    String?
  note         String?
  paidAt       DateTime @default(now())
  recordedById String?  @db.Uuid
  createdAt    DateTime @default(now())

  customer ControlCustomer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  license  ControlLicense? @relation(fields: [licenseId], references: [id], onDelete: SetNull)

  @@index([customerId, paidAt])
  @@map("control_payments")
}

enum ControlActivationStatus {
  ACTIVE
  BLOCKED
  REPLACED
  REVOKED
  // A new Device ID (or a reconnected old one) waiting for the Owner's approval.
  PENDING
}

// One activated installation (the cashier computer). Bound to the customer and to a
// device-generated key pair: every request is signed by the private key.
model ControlActivation {
  id              String                  @id @default(uuid(7)) @db.Uuid
  customerId      String                  @db.Uuid
  licenseId       String                  @db.Uuid
  installId       String
  deviceName      String
  model           String?
  os              String?
  platform        String                  @default("DESKTOP")
  appVersion      String?
  publicKey       String
  fingerprint     String                  @unique
  status          ControlActivationStatus @default(ACTIVE)
  branchName      String?
  activatedAt     DateTime                @default(now())
  lastHeartbeatAt DateTime?
  lastIp          String?
  currentUser     String?
  // Highest request counter seen; lower or equal counters are replays.
  lastSeq         BigInt                  @default(0)
  // Commands for the device (terminate sessions...), delivered on its next beat.
  pendingCommands Json                    @default("[]")
  // Reported by the install: queue size, unresolved sync errors, uptime.
  stats           Json?
  replacedAt      DateTime?
  blockedReason   String?
  // Name the Owner gives the computer (shown instead of the reported one).
  displayName     String?
  // Windows computer name as last reported by the install.
  hostname        String?
  // What the installed agent can do remotely (e.g. "rekey", "rename_host").
  capabilities    String[]                @default([])
  // Old registration removed from the Owner's lists (data kept).
  archivedAt      DateTime?
  // Last Windows computer-name change asked by the Owner and its outcome.
  hostRename      Json?
  updatedAt       DateTime                @updatedAt

  customer  ControlCustomer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  license   ControlLicense    @relation(fields: [licenseId], references: [id], onDelete: Restrict)
  terminals ControlTerminal[]

  @@index([customerId, status])
  @@index([licenseId, status])
  @@map("control_activations")
}

// Terminals (kitchen screens, waiter phones) registered on a cashier host, as
// reported by the host.
model ControlTerminal {
  id           String    @id @default(uuid(7)) @db.Uuid
  activationId String    @db.Uuid
  localId      String
  name         String
  branchName   String?
  panel        String    @default("OTHER")
  status       String    @default("ACTIVE")
  appVersion   String?
  model        String?
  os           String?
  lastSeenAt   DateTime?
  lastIp       String?
  currentUser  String?
  updatedAt    DateTime  @updatedAt

  activation ControlActivation @relation(fields: [activationId], references: [id], onDelete: Cascade)

  @@unique([activationId, localId])
  @@map("control_terminals")
}

model ControlBranch {
  id             String   @id @default(uuid(7)) @db.Uuid
  customerId     String   @db.Uuid
  code           String
  name           String
  isActive       Boolean  @default(true)
  lastReportedAt DateTime @default(now())

  customer ControlCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, code])
  @@map("control_branches")
}

// Per-customer policy: feature switches, delegation, offline rules, visibility,
// version rules. `version` increases on every change and is carried in grants.
model ControlPolicy {
  customerId        String    @id @db.Uuid
  version           Int       @default(1)
  // { [featureKey]: { mode?: ON|OFF|ADMIN, online?: boolean, offline?: boolean } }
  features          Json      @default("{}")
  offlineEnabled    Boolean   @default(false)
  maxOfflineMinutes Int       @default(0)
  minAppVersion     String?
  // Installs below minAppVersion stop taking new orders only after this moment.
  minVersionFrom    DateTime?
  // { override: { expiresAt, grantedAt, roles, reason } | null }: the vendor's time-limited
  // exception to local-network-only operation (null/absent = no exception).
  network           Json?
  updatedAt         DateTime  @updatedAt
  updatedById       String?   @db.Uuid

  customer ControlCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("control_policies")
}

enum ControlSyncStatus {
  APPLIED
  DUPLICATE
  CONFLICT
  REJECTED
}

// Idempotency ledger for operations that devices synchronize to the centre.
model ControlSyncOp {
  id           String            @id @default(uuid(7)) @db.Uuid
  customerId   String            @db.Uuid
  activationId String            @db.Uuid
  opId         String
  type         String
  payloadHash  String
  payload      Json
  status       ControlSyncStatus
  result       Json?
  receivedAt   DateTime          @default(now())

  customer ControlCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, opId])
  @@index([customerId, receivedAt])
  @@map("control_sync_ops")
}

enum ControlReleaseStage {
  DRAFT
  STAGED
  ALL
  WITHDRAWN
}

model ControlRelease {
  id             String              @id @default(uuid(7)) @db.Uuid
  platform       String
  version        String
  url            String
  sha256         String
  size           Int?
  notes          String?
  stage          ControlReleaseStage @default(DRAFT)
  // Share of installs (0-100) that see this release while STAGED.
  rolloutPercent Int                 @default(0)
  // Installs older than this must update (blocks new operations until updated).
  minVersion     String?
  signature      String
  createdById    String?             @db.Uuid
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([platform, version])
  @@map("control_releases")
}

// Append-only evidence of every Owner action, licence event and suspicious attempt.
model ControlAuditLog {
  id         BigInt   @id @default(autoincrement())
  ownerId    String?  @db.Uuid
  customerId String?  @db.Uuid
  action     String
  entityType String?
  entityId   String?
  outcome    String   @default("SUCCESS")
  data       Json?
  ipAddress  String?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([customerId, createdAt])
  @@index([action, createdAt])
  @@map("control_audit_logs")
}

// ---- customer (install) side -------------------------------------------------

// Link between this install and the central server (singleton row).
model ControlLink {
  id             Int       @id @default(1)
  serverUrl      String
  activationId   String
  customerId     String
  licenseHint    String?
  // Signed grant document as issued by the server; verified on every load.
  grant          String
  grantIssuedAt  DateTime
  grantExpiresAt DateTime
  policyVersion  Int       @default(0)
  // Local time of the last successful contact with the server.
  lastContactAt  DateTime?
  // Highest time ever observed (system clock or server); rollback cannot lower it.
  highWater      DateTime  @default(now())
  // Server verdict: ACTIVE, SUSPENDED, REVOKED, BLOCKED, REPLACED.
  serverStatus   String    @default("ACTIVE")
  requestSeq     BigInt    @default(0)
  // Sealed (APP_SECRET_KEY) device private key when the launcher gave none.
  deviceKeyEnc   String?
  lastError      String?
  // Windows computer-name change asked by the Owner, waiting for this restaurant's
  // Admin to agree (or its outcome until reported).
  hostRenameRequest Json?
  updatedAt      DateTime  @updatedAt

  @@map("control_link")
}

enum SyncOpStatus {
  PENDING
  DONE
  CONFLICT
  FAILED
}

// Durable outbox: operations are stored before sending and removed only after the
// server confirmed them, so a crash or outage never loses or duplicates one.
model SyncOperation {
  id            String       @id @default(uuid(7)) @db.Uuid
  opId          String       @unique
  type          String
  payload       Json
  status        SyncOpStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now())
  lastError     String?
  result        Json?
  createdAt     DateTime     @default(now())
  doneAt        DateTime?

  @@index([status, nextAttemptAt])
  @@map("sync_operations")
}

// Switches a restaurant Admin set for features SUPER_OWNER delegated (mode ADMIN).
model FeatureSetting {
  tenantId    String   @db.Uuid
  featureKey  String
  // Role key the setting applies to; '*' = every role.
  roleKey     String   @default("*")
  // Null when only parameter values were set (no on/off decision).
  enabled     Boolean?
  // Values the Admin chose for delegated parameters (limits, default modes).
  params      Json?
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt

  @@id([tenantId, featureKey, roleKey])
  @@map("feature_settings")
}

// Named receipt / ticket templates (paper width, margins, fonts, visible fields). The
// restaurant's original single layout stays in TenantProfile.receiptSettings and acts
// as the default; templates are assigned to a printer, a department or a receipt type.
model ReceiptTemplate {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  // CUSTOMER (customer receipt) or KITCHEN (kitchen ticket).
  kind      String   @default("CUSTOMER")
  settings  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments ReceiptAssignment[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@map("receipt_templates")
}

model ReceiptAssignment {
  tenantId   String @db.Uuid
  // PRINTER, STATION (department) or TYPE (default of a receipt kind).
  targetType String
  // Printer id, kitchen station id, or the kind (CUSTOMER / KITCHEN) for TYPE.
  targetId   String
  templateId String @db.Uuid

  template ReceiptTemplate @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, targetType, targetId])
  @@index([tenantId, templateId])
  @@map("receipt_assignments")
}

// ---- Branding: central advertising and remote design (additive) ----

// Uploaded advertising / branding pictures and videos. Only validated image/video
// bytes are stored (never SVG or HTML). The central copy is the source; installs keep
// a verified copy (sha256 from the signed bundle) for offline display.
model BrandingMedia {
  id        String   @id @default(uuid(7)) @db.Uuid
  kind      String
  mime      String
  name      String
  sizeBytes Int
  sha256    String
  data      Bytes
  createdAt DateTime @default(now())

  @@index([sha256])
  @@map("branding_media")
}

// Design decided by the Owner. key = "global" (all restaurants) or a customer id.
model BrandingDesign {
  key         String   @id
  config      Json
  version     Int      @default(1)
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  @@map("branding_designs")
}

// Design chosen by a restaurant Admin when the Owner delegated it (feature design.admin).
model TenantDesign {
  tenantId    String   @id @db.Uuid
  config      Json
  version     Int      @default(1)
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  @@map("tenant_designs")
}

model AdCampaign {
  id           String    @id @default(uuid(7)) @db.Uuid
  title        String
  // TEXT | IMAGE | VIDEO
  kind         String
  // FULLSCREEN | POPUP | BANNER
  format       String
  text         String?
  mediaId      String?   @db.Uuid
  // ADMIN | CASHIER | WAITER | KITCHEN | CUSTOMER
  panels       String[]
  // ALL | SELECTED
  targetMode   String    @default("ALL")
  durationSec  Int       @default(10)
  closable     Boolean   @default(true)
  autoCloseSec Int?
  startsAt     DateTime?
  endsAt       DateTime?
  // Minimum minutes between two displays on one screen, and a daily cap.
  everyMinutes Int       @default(0)
  maxPerDay    Int?
  priority     Int       @default(0)
  // DRAFT | ACTIVE | PAUSED
  status       String    @default("DRAFT")
  version      Int       @default(1)
  createdById  String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  targets AdTarget[]

  @@index([status])
  @@map("ad_campaigns")
}

model AdTarget {
  campaignId String @db.Uuid
  customerId String @db.Uuid

  campaign AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@id([campaignId, customerId])
  @@index([customerId])
  @@map("ad_targets")
}

// Display counters per campaign, restaurant, day and panel. On an install the rows are
// written locally and reported to the centre as cumulative values (idempotent).
model AdStat {
  campaignId String   @db.Uuid
  customerId String   @db.Uuid
  day        DateTime @db.Date
  panel      String
  shown      Int      @default(0)
  closed     Int      @default(0)
  // Install side: what the centre has already been told.
  shownSent  Int      @default(0)
  closedSent Int      @default(0)

  @@id([campaignId, customerId, day, panel])
  @@map("ad_stats")
}

// Which install received which campaign version (central side).
model AdDelivery {
  campaignId   String    @db.Uuid
  customerId   String    @db.Uuid
  activationId String    @db.Uuid
  version      Int
  sentAt       DateTime  @default(now())
  ackedAt      DateTime?

  @@id([campaignId, activationId])
  @@index([customerId])
  @@map("ad_deliveries")
}

// Install side: the last signed branding bundle (design + campaigns) for offline use.
model BrandingCache {
  id         Int      @id @default(1)
  version    String
  bundle     Json
  receivedAt DateTime @default(now())

  @@map("branding_cache")
}

// Which report sections and columns a restaurant shows (screen, preview and exports).
// Visibility is presentation only: permissions are still checked for every section.
model ReportLayout {
  tenantId    String   @id @db.Uuid
  config      Json
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt

  @@map("report_layouts")
}

enum StockAlertSeverity {
  LOW
  CRITICAL
  OUT
}

enum StockAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

// One active alert per item and warehouse (a partial unique index keeps it that way);
// raised and resolved from the ledger, never from a second stock balance.
model StockAlert {
  id               String             @id @default(uuid(7)) @db.Uuid
  tenantId         String             @db.Uuid
  warehouseId      String             @db.Uuid
  stockItemId      String             @db.Uuid
  severity         StockAlertSeverity
  status           StockAlertStatus   @default(OPEN)
  quantity         Decimal            @db.Decimal(14, 3)
  threshold        Decimal            @db.Decimal(14, 3)
  openedAt         DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  acknowledgedAt   DateTime?
  acknowledgedById String?            @db.Uuid
  resolvedAt       DateTime?

  @@index([tenantId, status])
  @@index([stockItemId, openedAt])
  @@map("stock_alerts")
}

model StockAlertSettings {
  tenantId        String   @id @db.Uuid
  enabled         Boolean  @default(true)
  soundEnabled    Boolean  @default(true)
  // "Critical" below this share of the minimum stock (percent).
  criticalPercent Int      @default(50)
  // Minutes between reminders while an alert stays unacknowledged (0 = no reminders).
  reminderMinutes Int      @default(10)
  updatedById     String?  @db.Uuid
  updatedAt       DateTime @updatedAt

  @@map("stock_alert_settings")
}

enum ControlRegistrationStatus {
  PENDING
  ASSIGNED
  REJECTED
}

// A first launch announcing itself to the vendor. It carries no privileges: the vendor (or
// the automatic trial rule for a brand-new install) decides what it receives.
model ControlRegistration {
  id              String                    @id @default(uuid(7)) @db.Uuid
  installId       String
  // Fingerprint of the install's own public key: the identity that signs every request.
  fingerprint     String                    @unique
  publicKey       String
  platform        String                    @default("DESKTOP")
  appVersion      String?
  label           String
  restaurantName  String?
  tenantKey       String?
  // First installation date on that computer (survives deleting the data folder).
  installedAt     DateTime?
  hasLocalLicense Boolean                   @default(false)
  status          ControlRegistrationStatus @default(PENDING)
  customerId      String?                   @db.Uuid
  licenseId       String?                   @db.Uuid
  // The licence key waiting to be collected by the device that registered (sealed).
  claimKeyEnc     String?
  lastIp          String?
  firstSeenAt     DateTime                  @default(now())
  lastSeenAt      DateTime                  @default(now())

  @@index([status, firstSeenAt])
  @@index([installId])
  @@index([tenantKey])
  @@map("control_registrations")
}

// Durable vendor notifications: stored centrally, read when the Owner next connects.
model ControlEvent {
  id             BigInt    @id @default(autoincrement())
  type           String
  // Retried requests carry the same key and never create a second event.
  dedupeKey      String    @unique
  customerId     String?   @db.Uuid
  registrationId String?   @db.Uuid
  data           Json      @default("{}")
  createdAt      DateTime  @default(now())
  readAt         DateTime?

  @@index([readAt, id])
  @@map("control_events")
}

model ControlSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("control_settings")
}

// Pictures uploaded for menu products (validated JPEG/PNG/WebP bytes, already reduced
// by the uploading app). Kept in the database so they survive updates and are part of
// every backup; served to the restaurant's apps and customer menus by id.
model ProductImage {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @db.Uuid
  mime        String
  sizeBytes   Int
  sha256      String
  data        Bytes
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@map("product_images")
}

// Workflow configurations of a customer, one row per activation (newest = active);
// older rows are the history the Owner can roll back to.
model ControlWorkflow {
  id          String   @id @default(uuid(7)) @db.Uuid
  customerId  String   @db.Uuid
  version     Int
  config      Json
  note        String?
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  customer ControlCustomer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([customerId, version])
  @@map("control_workflows")
}
