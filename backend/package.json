{
  "name": "@fastfood/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run --exclude \"test/**/*.integration.test.ts\"",
    "test:integration": "prisma migrate deploy && vitest run --no-file-parallelism integration",
    "db:check": "tsx src/check-database.ts",
    "db:validate": "prisma validate",
    "generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "admin:create": "node dist/cli/create-platform-admin.js",
    "admin:create:dev": "tsx src/cli/create-platform-admin.ts",
    "seed:demo": "tsx src/cli/seed-demo.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "prisma": "7.10.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
