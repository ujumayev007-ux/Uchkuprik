{
  "name": "fastfood-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "dev": "concurrently --kill-others -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build --workspaces",
    "start": "npm run db:migrate -w backend && node scripts/start.mjs",
    "test:deploy": "node scripts/smoke-render.mjs",
    "typecheck": "npm run typecheck --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w backend",
    "test:integration": "npm run test:integration -w backend",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "db:up": "docker compose up -d --wait db",
    "db:stop": "docker compose stop db",
    "db:check": "npm run db:check -w backend",
    "db:validate": "npm run db:validate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "admin:create": "npm run admin:create -w backend"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    },
    "prisma": {
      "mysql2": "3.24.5"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true
  }
}
